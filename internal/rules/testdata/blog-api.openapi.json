{
  "openapi": "3.1.0",
  "info": {
    "title": "Blog draft and media API",
    "version": "1.0.0",
    "description": "Disabled by default; production enables it for a source-IP-restricted launch. CloudFront requires an approved source IP; edge denials can be empty/non-JSON 400 or 403 responses. Own drafts only; no machine publication, deletion or browser-admin access. 30 resource requests/minute and 100 mutation attempts/UTC day per client. Reuse tokens; do not cache secrets or upload forms. GET/HEAD consume request quota. Authorized malformed/failed operations still count. All routes/errors are private/no-store. Refuse redirects and send x-amz-content-sha256 for POST/PUT through CloudFront."
  },
  "servers": [
    {
      "url": "https://rahulbalajee.com"
    }
  ],
