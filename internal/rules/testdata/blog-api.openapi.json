  "components": {
    "securitySchemes": {
      "clientCredentials": {
        "type": "oauth2",
        "description": "Token exchange uses client_secret_basic, never cookie authentication. Ten-minute RS256 tokens; no refresh tokens. See oauth.md for token endpoint request/errors.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://rahulbalajee.com/oauth/token",
            "scopes": {
              "drafts:read": "Read/list own drafts",
              "drafts:write": "Create/update own drafts",
              "media:write": "Request upload forms for own posts"
            }
          }
        }
      }
    },
    "schemas": {
      "ArticleInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "summary", "body"],
        "properties": {
          "formatVersion": {
            "type": "integer",
            "description": "Optional; the existing service normalizes any integer to 1."
          },
          "title": {"$ref": "#/components/schemas/Article/properties/title"},
          "summary": {"$ref": "#/components/schemas/Article/properties/summary"},
          "body": {"$ref": "#/components/schemas/Article/properties/body"},
          "tags": {"$ref": "#/components/schemas/Article/properties/tags"}
        }
      },
      "Article": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "formatVersion",
          "title",
          "summary",
          "body",
          "tags"
        ],
        "properties": {
          "formatVersion": {
            "type": "integer",
            "const": 1
          },
          "title": {
            "type": "string",
            "description": "Trimmed UTF-8 byte length 3\u2013160."
          },
          "summary": {
            "type": "string",
            "description": "Trimmed UTF-8 byte length 10\u2013300."
          },
          "body": {
            "type": "string",
            "description": "HTML, 1\u201381920 bytes before sanitization, nonempty text after sanitization; up to 8 distinct site-owned images with alt text."
          },
          "tags": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "description": "Trimmed UTF-8 byte length 1\u201332."
            }
          }
        }
      },
      "Draft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "authorName",
          "draft",
          "revision",
          "createdAt",
          "updatedAt",
          "hasPublishedSnapshot"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "authorName": {
            "type": "string"
          },
          "draft": {
            "$ref": "#/components/schemas/Article"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "hasPublishedSnapshot": {
            "type": "boolean",
            "description": "Owner-controlled public snapshot exists. API writes change only the draft."
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "posts"
        ],
        "properties": {
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Draft"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "Upload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "fields",
          "previewUrl"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Short-lived S3 form destination; never send website credentials here."
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "previewUrl": {
            "type": "string",
            "description": "Private /api/admin/media/... reference for stored HTML; human browser session required to fetch."
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Malformed input or unsupported authentication transport.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string"
            },
            "description": "private, no-store"
          },
          "Pragma": {
            "schema": {
              "type": "string"
            },
            "description": "no-cache"
          },
          "X-Robots-Tag": {
            "schema": {
              "type": "string"
            },
            "description": "noindex, nofollow"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing/invalid/expired/revoked token.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string"
            },
            "description": "private, no-store"
          },
          "Pragma": {
            "schema": {
              "type": "string"
            },
            "description": "no-cache"
          },
          "X-Robots-Tag": {
            "schema": {
              "type": "string"
            },
            "description": "noindex, nofollow"
          },
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "description": "Bearer challenge set by the application; insufficient_scope includes required scope. Absent through the deployed distribution: the Lambda Function URL renames it to x-amzn-remapped-www-authenticate."
          },
          "x-amzn-remapped-www-authenticate": {
            "schema": {
              "type": "string"
            },
            "description": "The application's Bearer challenge as delivered through CloudFront and the Lambda Function URL. Rely on the status code and JSON error; read this header only as a hint."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
